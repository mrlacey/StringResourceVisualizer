<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Visual Studio extension">
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.VisualStudio.LanguageServices" Version="4.11.0" />
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.10.40171" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />
    <PackageVersion Include="WarnAboutTODOs" Version="1.7.0" />
  </ItemGroup>

  <!-- Dependencies that the projects name explicitly, so that the version does not depend on the Visual Studio packages that bring them in. -->
  <ItemGroup Label="Pinned dependencies">
    <PackageVersion Include="MessagePack" Version="2.5.192" />
    <PackageVersion Include="Microsoft.IO.Redist" Version="6.1.0" />
    <PackageVersion Include="Microsoft.ServiceHub.Framework" Version="4.7.36" />
    <PackageVersion Include="StreamJsonRpc" Version="2.20.17" />
    <PackageVersion Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageVersion Include="System.Text.Encoding" Version="4.3.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <PackageVersion Include="System.Text.Encoding.Extensions" Version="4.3.0" />
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="MSTest.Analyzers" Version="3.6.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.6.3" />
  </ItemGroup>

</Project>