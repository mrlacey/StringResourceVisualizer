<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <CodeAnalysisRuleSet>StringResourceVisualizer.ruleset</CodeAnalysisRuleSet>
    <!-- The test project lives in a subfolder of this one, so the default globbing must not include its files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StringResourceVisualizer.Tests\**</DefaultItemExcludes>

    <!-- Properties\AssemblyInfo.cs takes the version from the Vsix.Version constant, which the CI build stamps. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The CI build, the instructions and the signing step expect the output in bin\Debug\ and bin\Release\. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The old project did not copy the symbols of this project to its output folder or to the output folder of the tests; the VSIX gets them from the intermediate folder. -->
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="OptionsGrid.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="source.extension.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>source.extension.vsixmanifest</DependentUpon>
    </Compile>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
      <Generator>VsixManifestGenerator</Generator>
      <LastGenOutput>source.extension.cs</LastGenOutput>
    </None>
    <AdditionalFiles Include="stylecop.json" />
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Icon.png" />
    <Content Include="..\LICENSE" Link="Resources\LICENSE" IncludeInVSIX="true" />
    <Content Include="Resources\Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.192" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.IO.Redist" Version="6.1.0" />
    <PackageReference Include="Microsoft.ServiceHub.Framework" Version="4.7.36" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.11.0" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.10.40171" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="StreamJsonRpc" Version="2.20.17" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding" Version="4.3.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <PackageReference Include="System.Text.Encoding.Extensions" Version="4.3.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="WarnAboutTODOs" Version="1.7.0" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" PrivateAssets="all" />
  </ItemGroup>

  <Import Project=".\signvsix.targets" />

</Project>